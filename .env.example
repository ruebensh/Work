# Nusxa oling: cp .env.example .env — keyin o'z qiymatlaringizni qo'ying
# BotFather'dan olingan token (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Ixtiyoriy: botdan foydalana oladigan chat id'lar (vergul bilan). Bo'sh = hamma.
# Id'ni bilish uchun: @userinfobot ga xabar yuboring
TELEGRAM_ALLOWED_CHAT_IDS=

# Ixtiyoriy: DB manzilini almashtirish (default: sqlite:///data/payments.db)
# DATABASE_URL=sqlite:///data/payments.db
